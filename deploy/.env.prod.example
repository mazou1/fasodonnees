# Configuration de production — copier en .env À LA RACINE du dépôt sur le VPS
#   cp deploy/.env.prod.example .env   puis éditer.
# NE JAMAIS committer le .env rempli (il est déjà gitignoré).

# --- Domaine & HTTPS -----------------------------------------------------------
DOMAIN=faso.example.org
# Adresse sur laquelle Caddy écoute. Laisser vide (ou 0.0.0.0) sur un serveur
# dédié. En cohabitation avec une autre pile, mettre l'IP réservée à ce projet
# — sinon les deux proxys se disputent les ports 80/443 (cf. README §4 bis).
IP_PUBLIQUE=
# Plafond CPU du worker : l'OCR consomme 200-300 %. Vide = aucune limite.
WORKER_CPUS=
ACME_EMAIL=admin@example.org           # e-mail Let's Encrypt (alertes expiration)

# --- Base de données -----------------------------------------------------------
# Générer : openssl rand -base64 24
POSTGRES_PASSWORD=REMPLACER_mot_de_passe_postgres

# --- Back-office / API ---------------------------------------------------------
FASO_ADMIN_USER=admin
# Générer : openssl rand -base64 24
FASO_ADMIN_PASSWORD=REMPLACER_mot_de_passe_admin_fort
# Générer : openssl rand -hex 32
FASO_SECRET_KEY=REMPLACER_cle_secrete_longue_aleatoire

# --- Archive brute : disque ou stockage objet ----------------------------------
# `local` = les PDF/HTML restent sur le disque du VPS (défaut, aucune dépendance).
# `s3`    = ils partent dans un bucket S3-compatible : Garage (conteneur du
#           compose, profil « garage ») OU n'importe quel S3 externe. Seul
#           FASO_S3_ENDPOINT distingue les deux.
#
# ⚠ Garage lancé sur CE VPS partage son disque et son domaine de panne :
#   il n'apporte alors aucune durabilité. Il ne protège que sur une autre
#   machine, en réplication multi-nœud, ou face à un S3 externe.
FASO_STOCKAGE=local
FASO_S3_ENDPOINT=            # http://garage:3900 (profil garage) ou https://s3.fournisseur.example
FASO_S3_BUCKET=faso-archives
FASO_S3_ACCESS_KEY=
FASO_S3_SECRET_KEY=
FASO_S3_REGION=garage
# URL publiques et stables du corpus (bucket en lecture publique, proxifié
# sous /archives par le nginx du front). Vide = URL présignées, qui expirent.
FASO_S3_URL_PUBLIQUE=/archives

# Secrets Garage — uniquement si le profil « garage » est activé.
# Générer chacun séparément : openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=

# --- Extraction LLM ------------------------------------------------------------
FASO_LLM_PROVIDER=mistral
FASO_MISTRAL_API_KEY=REMPLACER_cle_mistral   # tier gratuit suffisant
FASO_ANTHROPIC_API_KEY=                       # optionnel (fallback Claude)

# --- Mesure d'audience ---------------------------------------------------------
# Uniquement si le profil « audience » est activé :
#   docker compose -f docker-compose.prod.yml --profile audience up -d
# Tableau de bord sous https://<domaine>/stats
# Générer : openssl rand -hex 32
UMAMI_APP_SECRET=
