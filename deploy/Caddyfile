# Reverse proxy + HTTPS automatique (Let's Encrypt).
# DOMAIN et ACME_EMAIL viennent de l'environnement (service caddy, via .env).

{
	# e-mail ACME (facultatif mais recommandé : alertes d'expiration)
	email {$ACME_EMAIL}
}

# « www » redirige vers l'apex, qui est la forme canonique. Sans ce bloc, Caddy
# n'a aucun certificat pour www.<domaine> et le navigateur affiche une erreur TLS
# — pas une page d'erreur, une alerte de handshake, illisible pour un visiteur.
# Or l'enregistrement DNS www existe presque toujours, et beaucoup de gens le
# tapent encore.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Tableau de bord d'audience, sur un sous-domaine.
#
# Il lui faut la racine : Umami est bâti sur Next.js, dont le préfixe de chemin
# est figé à la compilation - `BASE_PATH` n'a aucun effet sur l'image publiée,
# et l'interface servie sous /stats appelle ses ressources à /_next, donc sur le
# site. Un sous-domaine évite ce conflit sans reconstruire l'image.
#
# Nécessite un enregistrement DNS A : stats.<domaine> → même adresse que l'apex.
{$DOMAIN_AUDIENCE:stats.invalid} {
	reverse_proxy umami:3000
}

{$DOMAIN} {
	encode zstd gzip

	# En-têtes de sécurité de base
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Back-office et documentation d'API → FastAPI directement.
	# Le front nginx ne connaît pas ces chemins ; Caddy les route vers l'API.
	@backend path /admin /admin/* /docs /redoc
	handle @backend {
		# Sécurité en plus : restreindre le back-office à des IP connues.
		# Décommentez et adaptez pour n'autoriser /admin que depuis votre réseau :
		# @adminblocked not client_ip 203.0.113.10 198.51.100.0/24
		# respond @adminblocked "Accès restreint" 403
		reverse_proxy api:8000
	}

	# Robots sociaux → pages Open Graph de l'API.
	#
	# Le site est une SPA Vue : son index.html porte le même titre et la même
	# description pour toutes les pages, et ces robots n'exécutent pas de
	# JavaScript. Sans cette règle, chaque lien partagé sur Facebook, X,
	# Telegram ou WhatsApp s'affiche avec une vignette générique identique -
	# tous les posts de la page se ressemblent. L'API rend le titre et le
	# résumé réels de l'entité (cf. backend/app/api/partage.py).
	#
	# La règle ne s'applique QU'aux robots : un visiteur reçoit la SPA comme
	# avant, et il n'y a donc pas deux contenus servis à un même lecteur.
	@robots_sociaux {
		header_regexp User-Agent (?i)(facebookexternalhit|facebot|twitterbot|telegrambot|whatsapp|linkedinbot|slackbot|discordbot|bluesky|mastodon|pinterest|skypeuripreview|redditbot)
		path_regexp ^/(conseils|documents)/[0-9]+/?$
	}
	handle @robots_sociaux {
		rewrite * /partage{uri}
		reverse_proxy api:8000
	}

	# Mesure d'audience (Umami), si le profil « audience » est actif.
	#
	# Seuls les DEUX points d'entrée du traceur passent par le domaine
	# principal : le script et l'envoi des vues. Un script d'analyse servi
	# depuis un autre domaine est bloqué par la plupart des bloqueurs de
	# publicité, et les chiffres ne veulent alors plus rien dire.
	#
	# `handle_path` retire le préfixe : Umami reçoit /script.js et /api/send.
	# L'envoi ne peut pas passer par /api/send directement - ce chemin est déjà
	# celui de l'API de la plateforme.
	handle_path /stats/* {
		reverse_proxy umami:3000
	}

	# Tout le reste → front nginx : il sert la SPA et proxifie /api/ et
	# /openapi.json vers l'API (avec le strip du préfixe /api).
	handle {
		reverse_proxy web:80
	}
}
