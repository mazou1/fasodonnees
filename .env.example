# Copier vers .env et ajuster
POSTGRES_PASSWORD=faso

# Backend (préfixe FASO_)
FASO_DATABASE_URL=postgresql+psycopg://faso:faso@localhost:5434/faso
FASO_DATA_DIR=./data
FASO_ADMIN_USER=admin
FASO_ADMIN_PASSWORD=change-me
FASO_SECRET_KEY=change-me-long-random
# Archive brute : local (disque) ou s3 (Garage du compose, ou S3 externe)
FASO_STOCKAGE=local
# FASO_S3_ENDPOINT=http://localhost:3900   # Garage : docker compose --profile garage up -d
# FASO_S3_BUCKET=faso-archives
# FASO_S3_ACCESS_KEY=
# FASO_S3_SECRET_KEY=
# FASO_S3_URL_PUBLIQUE=/archives   # corpus public à URL stables (vide = présignées)
# Secrets Garage (profil « garage » seulement) — openssl rand -hex 32, un par ligne
# GARAGE_RPC_SECRET=
# GARAGE_ADMIN_TOKEN=

# Extraction LLM des comptes rendus (décisions + nominations)
FASO_LLM_PROVIDER=mistral              # mistral (tier gratuit) | anthropic
FASO_MISTRAL_API_KEY=...               # console.mistral.ai → API keys (plan Experiment gratuit)
# FASO_ANTHROPIC_API_KEY=sk-ant-...   # si FASO_LLM_PROVIDER=anthropic

# ── Diffusion sur les réseaux sociaux (cf. backend/app/diffusion/) ─────────
# Coupe-circuit : tant qu'il vaut false, aucun post n'est envoyé, même avec des
# jetons valides. À passer à true seulement sur le serveur de production.
FASO_DIFFUSION_ACTIVE=false
FASO_SITE_URL=https://fasodonnees.org
# genres publiés : conseil, decision, actualite
FASO_DIFFUSION_GENRES=conseil,decision,actualite
# aucun item plus vieux que cette fenêtre n'est publié (garde-fou d'amorçage)
FASO_DIFFUSION_FRAICHEUR_JOURS=2
# vignette des cartes de partage : URL ABSOLUE d'une image 1200x630
# FASO_OG_IMAGE_URL=https://fasodonnees.org/og.png

# Telegram — @BotFather crée le bot, puis ajoutez-le comme ADMINISTRATEUR du canal
# FASO_TELEGRAM_BOT_TOKEN=123456:AA...
# FASO_TELEGRAM_CHAT_ID=@faso_donnees
# FASO_TELEGRAM_QUOTA_JOUR=40

# Facebook — developers.facebook.com : app, page, jeton de page LONGUE DURÉE
# (permissions pages_manage_posts + pages_read_engagement)
# FASO_FACEBOOK_PAGE_ID=1234567890
# FASO_FACEBOOK_PAGE_TOKEN=EAAG...
# FASO_FACEBOOK_QUOTA_JOUR=15

# X — developer.x.com : app en « Read and write », clés OAuth 1.0a
# Palier gratuit : 500 posts/mois. 12/jour laisse ~370/mois, sous le plafond.
# FASO_X_API_KEY=
# FASO_X_API_SECRET=
# FASO_X_ACCESS_TOKEN=
# FASO_X_ACCESS_SECRET=
# FASO_X_QUOTA_JOUR=12
